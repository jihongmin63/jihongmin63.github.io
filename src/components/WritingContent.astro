---
import { copy } from '../lib/copy.mjs';
import { writingPagePath } from '../lib/site.mjs';

const { lang, posts, page, pageCount } = Astro.props;
const c = copy[lang];
const base = import.meta.env.BASE_URL;
---
<section class="page-intro">
  <div class="page-index"><span>03 / 03</span><span>Writing</span></div>
  <h1>{c.writing}</h1>
  <p>{c.writingIntro}</p>
</section>
{posts.length === 0
  ? <div class="empty-panel"><p>{c.instagramPending}</p><a href="https://www.instagram.com/themenostalgia/">{c.openInstagram} ↗</a></div>
  : <>
    <div class="section-heading"><h2>Instagram · @themenostalgia</h2><a href="https://www.instagram.com/themenostalgia/">{c.openInstagram} ↗</a></div>
    <ol class="post-grid">
      {posts.map((post) => <li class="post-card">
        <a class="post-preview" href={post.permalink} aria-label={c.openPost}>
          {post.previewUrl ? <img src={post.previewUrl} alt="" loading="lazy" /> : <span class="post-preview-fallback">Instagram ↗</span>}
        </a>
        <div class="post-content">
          <time datetime={post.timestamp}>{new Date(post.timestamp).toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US')}</time>
          {post.caption && <p>{post.caption}</p>}
          <a href={post.permalink}>{c.openPost} ↗</a>
        </div>
      </li>)}
    </ol>
    {pageCount > 1 && <nav class="pagination" aria-label={lang === 'ko' ? '글 페이지' : 'Writing pages'}>
      {page > 1 ? <a href={writingPagePath(lang, page - 1, base)}>← {c.previousPage}</a> : <span></span>}
      <span>{c.page} {page} / {pageCount}</span>
      {page < pageCount ? <a href={writingPagePath(lang, page + 1, base)}>{c.nextPage} →</a> : <span></span>}
    </nav>}
  </>}
