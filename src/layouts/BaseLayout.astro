---
import { copy } from '../lib/copy.mjs';
import { localizedPath, writingPagePath } from '../lib/site.mjs';
import '../styles/global.css';

const { lang, title, section = '', page = 1, description = '' } = Astro.props;
const c = copy[lang];
const isHome = !section;
const other = lang === 'ko' ? 'en' : 'ko';
const base = import.meta.env.BASE_URL;
const otherPath = section === 'writing' ? writingPagePath(other, page, base) : localizedPath(other, section, base);
const currentPath = section === 'writing' ? writingPagePath(lang, page, base) : localizedPath(lang, section, base);
const fullTitle = title ? `${title} · ${c.siteName}` : c.siteName;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description || c.homeIntro} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class={isHome ? 'site-shell home-shell' : 'site-shell'}>
      <header class="site-header">
        {!isHome && <a class="wordmark" href={localizedPath(lang, '', base)} aria-label={c.home}>Jihong Min<span aria-hidden="true">.</span></a>}
        {!isHome && <nav class="section-nav" aria-label={lang === 'ko' ? '페이지' : 'Pages'}>
          <a href={localizedPath(lang, 'research', base)} aria-current={section === 'research' ? 'page' : undefined}>{c.research}</a>
          <a href={localizedPath(lang, 'cinema', base)} aria-current={section === 'cinema' ? 'page' : undefined}>{c.cinema}</a>
          <a href={localizedPath(lang, 'writing', base)} aria-current={section === 'writing' ? 'page' : undefined}>{c.writing}</a>
        </nav>}
        <nav class="language-nav" aria-label={lang === 'ko' ? '언어 선택' : 'Language'}>
          <a href={lang === 'ko' ? currentPath : otherPath} aria-current={lang === 'ko' ? 'page' : undefined} lang="ko">KO</a>
          <span aria-hidden="true">/</span>
          <a href={lang === 'en' ? currentPath : otherPath} aria-current={lang === 'en' ? 'page' : undefined} lang="en">EN</a>
        </nav>
      </header>
      <main id="main-content" class={isHome ? 'home-main' : undefined}><slot /></main>
    </div>
  </body>
</html>
