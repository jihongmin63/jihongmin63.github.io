---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy } from '../../lib/copy.mjs';
import { languages } from '../../lib/site.mjs';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang;
const c = copy[lang];
const base = import.meta.env.BASE_URL;
const projects = [
  { title: c.researchOne, description: c.researchOneDescription, status: c.current },
  { title: c.researchTwo, description: c.researchTwoDescription, status: c.current },
  { title: c.researchThree, description: c.researchThreeDescription, status: c.previous },
];
---
<BaseLayout lang={lang} title={c.research} section="research" description={c.researchIntro}>
  <h1 class="page-title">{c.research}</h1>
  <div class="research-list">
    {projects.map((project) => <article class="research-item">
      <h2>{project.title}</h2>
      <div><p class="item-status">{project.status}</p><p>{project.description}</p></div>
    </article>)}
  </div>
  <p class="research-cv"><a href={`${base}Jihong_Min_CV_2026_.pdf`}>CV ↗</a></p>
</BaseLayout>
