---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingContent from '../../components/WritingContent.astro';
import allPosts from '../../data/instagram.json';
import { copy } from '../../lib/copy.mjs';
import { languages, localizedPath, paginate } from '../../lib/site.mjs';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang;
const c = copy[lang];
const base = import.meta.env.BASE_URL;
const { items, pageCount } = paginate(allPosts, 1);
---
<BaseLayout lang={lang} title={c.writing} section="writing" description={c.writingIntro}>
  <a class="back-link" href={localizedPath(lang, '', base)}>← {c.back}</a>
  <WritingContent lang={lang} posts={items} page={1} pageCount={pageCount} />
</BaseLayout>
