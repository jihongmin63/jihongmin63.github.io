---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieList from '../../components/MovieList.astro';
import movies from '../../data/movies.json';
import { copy } from '../../lib/copy.mjs';
import { languages, localizedPath } from '../../lib/site.mjs';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang;
const c = copy[lang];
const base = import.meta.env.BASE_URL;
const createdFilms = ['메트로늄', '그리고 나무'];
---
<BaseLayout lang={lang} title={c.cinema} section="cinema" description={c.cinemaIntro}>
  <a class="back-link" href={localizedPath(lang, '', base)}>← {c.back}</a>
  <section class="page-intro">
    <div class="page-index"><span>02 / 03</span><span>Cinema</span></div>
    <h1>{c.cinema}</h1>
    <p>{c.cinemaIntro}</p>
  </section>
  <section class="content-section">
    <div class="section-heading"><h2>{c.myFilms}</h2><span>{createdFilms.length} {c.filmsCount}</span></div>
    <div class="created-films">
      {createdFilms.map((title) => <article class="created-film">
        <h3>{title}</h3>
        <p>{c.filmClub}</p>
      </article>)}
    </div>
  </section>
  <section class="content-section">
    <div class="section-heading"><h2>{c.watchedFilms}</h2><span>{movies.length} {c.filmsCount}</span></div>
    {movies.length ? <MovieList lang={lang} movies={movies} /> : <div class="empty-panel"><p>{c.filmsPending}</p></div>}
  </section>
</BaseLayout>
