---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import { copy } from '../../lib/copy.mjs';
import { languages } from '../../lib/site.mjs';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang;
const c = copy[lang];
---
<BaseLayout lang={lang} description={c.cardIntro1}>
  <BusinessCard lang={lang} />
</BaseLayout>
